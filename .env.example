# Copy to .env (gitignored). This example covers only what the data import
# script (`npm run import:proposals`) needs. See the README for the full setup;
# the frontend build and Edge Function secrets are configured elsewhere (the
# hosting platform's build env and Supabase function secrets), not here.

# Server-side only, and BYPASSES row-level security.
# WARNING: never prefix this with VITE_. A VITE_ prefix would bundle it into the
# public browser build and hand anyone full access to your database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project URL for the import. Optional if VITE_SUPABASE_URL is already set (the
# import falls back to it); otherwise set it explicitly here.
# SUPABASE_URL=https://your-project-ref.supabase.co
